# Copy to .env and fill in. .env is git-ignored. Never commit keys.
# Without ANTHROPIC_API_KEY the app runs in fixture mode (saved demo responses, clearly labeled).
ANTHROPIC_API_KEY=

# Provider and models (configurable; prices live in config/pricing.yaml)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# Effort for the answer model: low | medium | high (blank to omit). Low keeps latency and cost down.
LLM_EFFORT=low
JUDGE_MODEL=claude-sonnet-5
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=1

# Force fixture mode even when a key is present (1/true)
FIXTURE_MODE=
# LAB_DB_PATH=results/lab.sqlite3
